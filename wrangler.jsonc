// Cloudflare Workers settings: builds the site with Eleventy and serves the
// result (_site/) as static files.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Lets Workers Builds publish a preview for each branch and pull request.
  "previews": {}
}
