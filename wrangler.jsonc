// Cloudflare Workers settings: serves the files in site/ as a static website.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/_fc/cms/*"]
  }
}
